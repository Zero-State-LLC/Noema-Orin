{
  "format": "noema-lifecycles/1",
  "_note": "Gates are headed entries in DECISIONS.md; their status is the text after the last comma of the heading. The order below is read from the existing gates; CI checks states only, not moves.",
  "kinds": {
    "gate": {
      "title": "Gate",
      "entries": {
        "file": "DECISIONS.md",
        "heading": "^## (?P<id>G-\\d+): .*, (?P<status>[A-Z][A-Z_ ]+)$"
      },
      "declared": "BLOCKED / NOT_COMPUTABLE → APPROVED (status after the comma in each `## G-NNN` heading of DECISIONS.md)",
      "states": [
        "BLOCKED",
        "NOT_COMPUTABLE",
        "APPROVED"
      ],
      "aliases": {
        "BLOCKED": [
          "blocked"
        ],
        "NOT_COMPUTABLE": [
          "not_computable"
        ],
        "APPROVED": [
          "approved"
        ]
      },
      "next": {
        "BLOCKED": [
          "APPROVED"
        ],
        "NOT_COMPUTABLE": [
          "BLOCKED",
          "APPROVED"
        ],
        "APPROVED": []
      }
    },
    "adr": {
      "title": "ADR",
      "files": "docs/adr/[0-9]*.md",
      "declared": "proposed → accepted → deprecated / superseded by ADR-NNNN; Status is optional and a bare ADR records an accepted decision (domain-modeling ADR-FORMAT.md)",
      "status": [
        "^status:\\s*(.+)$",
        "^\\s*[-*]?\\s*\\*\\*Status:?\\*\\*:?\\s*(.+)$"
      ],
      "default": "accepted",
      "states": [
        "proposed",
        "accepted",
        "deprecated",
        "superseded"
      ],
      "aliases": {
        "proposed": [
          "proposed"
        ],
        "accepted": [
          "accepted"
        ],
        "deprecated": [
          "deprecated"
        ],
        "superseded": [
          "superseded"
        ]
      },
      "next": {
        "proposed": [
          "accepted",
          "superseded"
        ],
        "accepted": [
          "deprecated",
          "superseded"
        ],
        "deprecated": [
          "superseded"
        ],
        "superseded": []
      },
      "links": {
        "superseded": {
          "pattern": "ADR-(\\d+)",
          "file_prefix": "{:04d}-"
        }
      }
    }
  }
}
