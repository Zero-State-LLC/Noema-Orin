[Unit]
Description=NOEMA Orin Mission Control kiosk on the attached monitor (D-077, Xorg + WebKit2GTK)
# System unit: Xorg needs a real console seat. Install to /etc/systemd/system/ (see FACTS.md).
After=systemd-user-sessions.service network-online.target
Conflicts=getty@tty1.service display-manager.service

[Service]
User=scrimshawlife
WorkingDirectory=/home/scrimshawlife
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
ExecStart=/usr/bin/xinit /home/scrimshawlife/noema-orin-src/deploy/jetson/kiosk-xinitrc -- :0 vt1 -nolisten tcp -keeptty
Restart=always
RestartSec=10
MemoryHigh=700M
MemoryMax=900M

[Install]
WantedBy=multi-user.target
