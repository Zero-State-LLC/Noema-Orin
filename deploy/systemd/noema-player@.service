[Unit]
Description=NOEMA Orin system role agent %i (Admin-minted, reserved system- id)
After=network-online.target ollama.service
PartOf=noema-players.target

[Service]
EnvironmentFile=%h/.config/noema-orin/%i.env
# Cloud reflection endpoint (D-015); optional so players still start without it.
EnvironmentFile=-%h/.config/noema-orin/memory-sync.env
# Dashboard-managed inference/voice mode overrides (D-077); never holds tokens.
EnvironmentFile=-%h/.config/noema-orin/runtime-overrides.env
Environment=PYTHONUNBUFFERED=1
StandardOutput=append:%h/noema-players/logs/%N.log
StandardError=append:%h/noema-players/logs/%N.log
WorkingDirectory=%h/noema-players
ExecStart=%h/noema-players/.venv/bin/python -m noema_orin.players --member %i
# T13/#167: bound unified-memory footprint per agent so 6 Python processes never starve Orin GPU RAM.
MemoryHigh=128M
MemoryMax=160M
CPUQuota=60%
Restart=on-failure
RestartPreventExitStatus=3
RestartSec=30
KillSignal=SIGTERM
TimeoutStopSec=60

[Install]
WantedBy=noema-players.target
